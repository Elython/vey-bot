{
  "name": "veyra-bot-client",
  "productName": "Veybot",
  "version": "2.5.3",
  "description": "Compact API-driven Electron automation client with dry-run safety and human-assisted challenges",
  "main": "src/main/index.js",
  "scripts": {
    "build:renderer": "node scripts/buildRenderer.js",
    "check:renderer": "node scripts/buildRenderer.js --check",
    "prepack": "npm run build:renderer",
    "prestart": "npm run build:renderer",
    "start": "electron .",
    "predry-run:live": "npm run build:renderer",
    "pretest": "npm run check:renderer",
    "test": "node test/runTests.js",
    "dry-run:live": "electron test/liveDryRun.js",
    "dist:win": "npm run build:renderer && electron-builder --win nsis --x64"
  },
  "keywords": [
    "electron",
    "game-bot",
    "automation",
    "demonicscans"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "lucide": "^1.48.0"
  },
  "build": {
    "appId": "com.veybot.client",
    "productName": "Veybot",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/lucide/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}